px4TAG=1.17.0_01
px4GPUTAG=1.17.0_01_GPU_GPUEnabled
# registry=localhost:8082/alienkh
registry=docker.io/alienkh
registryGPU=docker.io/alienkh

# OAK-D S2 mount on the x500. Pitch is degrees, positive lens-down.
# 17 deg is the previous 0.3 rad sensor pitch. xyz is PX4 x500_depth's include.
CAM_PITCH_DEG=17
CAM_X=0.12
CAM_Y=0.03
CAM_Z=0.242
# RTAB-Map viewer. false keeps headless CI from opening a window.
RTABMAPVIZ=false
# scripts/eval_slam_accuracy.py gates. SE(3) alignment only. Not tuned on a flight.
SLAM_APE_RMS_MAX=0.50
SLAM_DRIFT_PER_M_MAX=0.10
# VISION_PROFILE selects stereo size, rate, and the RTAB-Map ini. Default is full.
#   cpu   320x200 at 10 Hz, light RTAB-Map. CPU-only simulation and CI. Not for a real OAK-D.
#   full  1280x800 at 30 Hz, standard RTAB-Map. Simulation on a machine with a GPU.
#   hw    1280x800 at 15 Hz, modest onboard RTAB-Map. Real OAK-D S2 on a LattePanda or Orin NX.
#         On the real camera, RGB-D (depth computed on the OAK-D) is lighter for the host than stereo.
VISION_PROFILE=full
# Optional per run. CAM_STEREO_RES or the width/height pair must be 1280x800, 640x400, or 320x200.
# Anything else is rejected. full or hw below 1280x720 logs a warning. CAM_RATE_HZ replaces the camera rate.
# CAM_STEREO_RES=
# CAM_RATE_HZ=
# CAM_STEREO_WIDTH=
# CAM_STEREO_HEIGHT=
# CAM_COLOR_WIDTH=
# CAM_COLOR_HEIGHT=
# IMU_RATE_HZ=
# HealthCheck/rtabmap_health_log.py gates, from /rtabmap/odom_info.
# Longest run of consecutive lost frames.
VISION_MAX_LOST_STREAK=3
# Frames from a loss until the first frame that is not lost. Each episode must finish inside this.
VISION_MAX_RECOVERY_FRAMES=2
# Sim-time odometry rate (header stamps). Wall-clock rate is reported and not gated.
VISION_MIN_ODOM_HZ=7
# Feature and inlier floors follow the profile unless set here.
# full (not yet measured at 1280x800; 120 was measured at 640x400): VISION_MIN_MEDIAN_FEATURES=120
# cpu (measured at 320x200): VISION_MIN_MEDIAN_FEATURES=40
# hw (not yet measured): VISION_MIN_MEDIAN_FEATURES=80
# full (not yet measured at 1280x800): VISION_MIN_INLIERS=20
# cpu (measured at 320x200): VISION_MIN_INLIERS=15
# hw (not yet measured): VISION_MIN_INLIERS=20
# VISION_MIN_MEDIAN_FEATURES=
# VISION_MIN_INLIERS=