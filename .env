px4TAG=1.17.0_01
px4GPUTAG=1.17.0_01_GPU_GPUEnabled
# registry=localhost:8082/alienkh
registry=docker.io/alienkh
registryGPU=docker.io/alienkh

# OAK-D S2 mount on the x500. Pitch is degrees, positive lens-down.
# 17 deg is the previous 0.3 rad sensor pitch. xyz is PX4 x500_depth's include.
CAM_PITCH_DEG=17
CAM_X=0.12
CAM_Y=0.03
CAM_Z=0.242
# RTAB-Map viewer. false keeps headless CI from opening a window.
RTABMAPVIZ=false
# scripts/eval_slam_accuracy.py gates. SE(3) alignment only. Not tuned on a flight.
SLAM_APE_RMS_MAX=0.50
SLAM_DRIFT_PER_M_MAX=0.10
# full keeps the OAK-D S2 spec: 640x400 stereo, 640x480 color, cameras 30 Hz, IMU 200 Hz.
# cpu is the headless llvmpipe set: 320x200 stereo, 320x240 color and depth, cameras 10 Hz, IMU 100 Hz.
VISION_PROFILE=full
# Optional. A set value replaces that one field of the profile above.
# CAM_RATE_HZ=
# CAM_STEREO_WIDTH=
# CAM_STEREO_HEIGHT=
# CAM_COLOR_WIDTH=
# CAM_COLOR_HEIGHT=
# IMU_RATE_HZ=
# HealthCheck/rtabmap_health_log.py gates, from /rtabmap/odom_info.
# Longest run of consecutive lost frames.
VISION_MAX_LOST_STREAK=3
# Frames from a loss until the first frame that is not lost. Each episode must finish inside this.
VISION_MAX_RECOVERY_FRAMES=2
# Sim-time odometry rate (header stamps). Wall-clock rate is reported and not gated.
VISION_MIN_ODOM_HZ=7
# Feature and inlier floors follow the profile unless set here.
# full default: VISION_MIN_MEDIAN_FEATURES=120
# cpu default: VISION_MIN_MEDIAN_FEATURES=40
# full default: VISION_MIN_INLIERS=20
# cpu default: VISION_MIN_INLIERS=15
# VISION_MIN_MEDIAN_FEATURES=
# VISION_MIN_INLIERS=