# Component versions for the PX4 SITL image.
# DockerBuild.sh, the Dockerfiles (as ARG defaults), and CI all read this file.
# Image tags that Compose pulls are local pins in .env, not component versions.
PX4_VERSION=1.17.0
PX4_MSGS_REF=v1.17.0
XRCE_AGENT_VERSION=v2.4.3
ROS_DISTRO=jazzy
REGISTRY=docker.io/alienkh
IMAGE_NAME=px4_sim
USER_UID=1000
USER_GID=1000
# Used only when WITH_CUDA_OPENCV=1. 8.6 is RTX 30xx, 8.9 is RTX 40xx.
# PTX is the highest of those so newer GPUs can JIT.
CUDA_ARCH_BIN="8.6;8.9"
CUDA_ARCH_PTX="8.9"
WITH_CUDA_OPENCV=0
OPENCV_VERSION=4.11.0
QGC_URL_NO_GPU=https://d176tv9ibo4jno.cloudfront.net/builds/master/QGroundControl-x86_64.AppImage
QGC_URL_GPU=https://d176tv9ibo4jno.cloudfront.net/latest/QGroundControl-x86_64.AppImage
