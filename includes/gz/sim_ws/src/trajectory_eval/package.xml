<?xml version="1.0"?>
<package format="3">
  <name>trajectory_eval</name>
  <version>0.1.0</version>
  <description>Record ground truth, GPS, RTAB-Map, and PX4 EKF2 trajectories and score them.</description>
  <maintainer email="pa.aerospace@gmail.com">Parsa Khaledi</maintainer>
  <license>BSD-3-Clause</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>px4_msgs</exec_depend>
  <exec_depend>rosbag2_py</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
