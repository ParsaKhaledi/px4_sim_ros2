<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="x500_depth">
    <!-- Reference copy of PX4-gazebo-models x500_depth. The live model in the
         PX4 tree is preferred when it exists. This file is not a Gazebo model
         and is not copied over the airframe. -->
    <include merge="true">
      <uri>x500</uri>
    </include>
    <include merge="true">
      <uri>model://OakD-Lite</uri>
      <pose>.12 .03 .242 0 0 0</pose>
    </include>
    <joint name="CameraJoint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
      <pose relative_to="base_link">.12 .03 .242 0 0 0</pose>
    </joint>
  </model>
</sdf>
