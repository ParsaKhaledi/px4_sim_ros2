# Copy to .env. Component versions live in versions.env.
# px4TAG / PX4_IMAGE are the image you pull, not the PX4 git tag.
# 1.17.0_121 is a published CPU tag. CI builds its own image for the flight.
# No 1.17 GPU tag is on the registry. px4GPUTAG names a local GPU build.
registry=docker.io/alienkh
registryGPU=docker.io/alienkh
px4TAG=1.17.0_121
px4GPUTAG=1.17.0_01_GPU_GPUEnabled
PX4_IMAGE=docker.io/alienkh/px4_sim:1.17.0_121
PX4_GPU_IMAGE=docker.io/alienkh/px4_sim:1.17.0_01_GPU_GPUEnabled

PX4_GZ_MODEL_POSE=-3,-1.6,0,0,0,3.14
# CameraType=rgbd
# World=default
# HEADLESS=0
# RTABMAPVIZ=false
# OAK-D mount. Pitch is degrees, positive lens-down. 17 deg is 0.3 rad.
CAM_PITCH_DEG=17
CAM_X=0.12
CAM_Y=0.03
CAM_Z=0.242
# VISION_PROFILE=cpu
# Optional camera-profile overrides. Unset leaves the profile's own values.
# CAM_RATE_HZ=
# CAM_STEREO_WIDTH=
# CAM_STEREO_HEIGHT=
# CAM_COLOR_WIDTH=
# CAM_COLOR_HEIGHT=
# IMU_RATE_HZ=
# VISION_MIN_ODOM_HZ=

# Legs 30 cm ± 3 cm. Overshoot 3 cm. Settle ±2 cm for 1 s, within 4 s.
# Yaw overshoot 5°, yaw settle ±3°. Hover clock starts after ±5 cm for 2 s.
E2E_TAKEOFF_HEIGHT_M=2.0
E2E_HOVER_S=10
E2E_LEG_LENGTH_M=0.3
E2E_HOVER_DRIFT_M=0.05
E2E_LEG_TOLERANCE_M=0.03
E2E_OVERSHOOT_M=0.03
E2E_SETTLE_TOLERANCE_M=0.02
E2E_SETTLE_HOLD_S=1
E2E_SETTLE_TIMEOUT_S=4
E2E_YAW_TOLERANCE_DEG=5
E2E_YAW_SETTLE_DEG=3
E2E_HOVER_HEIGHT_BAND_M=0.05
E2E_HOVER_HEIGHT_HOLD_S=2
E2E_RETURN_TOLERANCE_M=0.05
E2E_HEIGHT_TOLERANCE_M=0.10
E2E_MAX_RETRIES=2
E2E_CRASH_TILT_DEG=60
E2E_CRASH_MIN_HEIGHT_M=0.20
E2E_CRASH_IMPACT_SPEED_MPS=2.5
E2E_CRASH_DIVERGENCE_M=1.5
E2E_ODOM_TIMEOUT_S=4
