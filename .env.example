# Docker image registry and tag (update px4TAG after CI builds)
registry=docker.io/alienkh
px4TAG=v3.0.0

# GPU image (deferred — see README)
registryGPU=docker.io/alienkh
px4GPUTAG=v3.0.0_GPU

# Runtime defaults (override on command line)
# CameraType=rgbd
# World=default

# Gazebo. HEADLESS=1 runs the server with EGL rendering and no GUI.
# HEADLESS=0
# HEADLESS_BACKEND=egl
# HEADLESS_SOFTWARE=0
# Spawn pose x,y,z,roll,pitch,yaw in the Gazebo ENU world (radians).
# PX4_GZ_MODEL_POSE=-3,-1.6,0,0,0,3.14
# USE_SIM_TIME=true

# /sim/preflight_check thresholds.
# PREFLIGHT_MIN_RTF is optional. Unset: 0.15 when HEADLESS_SOFTWARE=1, else 0.8.
# PREFLIGHT_MIN_RTF=0.15
# PREFLIGHT_MAX_POSE_ERR_M=0.10
# IMU on ROS /imu. oak bridges the Oak-D IMU (frame imu_link).
# px4 relays the flight IMU (frame base_link) from /fmu/out/sensor_combined.
# IMU_SOURCE=oak
# PX4_IMU_RATE_HZ=100
# Optional mount override, same names as the vision profile work.
# Unset, the pose is parsed from the x500_depth and Oak-D SDFs.
# CAM_PITCH_DEG is degrees, positive lens-down, and replaces the mount pitch.
# CAM_PITCH_DEG=
# CAM_X=
# CAM_Y=
# CAM_Z=
# VISION_PROFILE=full
# Camera and IMU minimums are optional. Unset, they are half the expected rate.
# Expected oak rate is CAM_RATE_HZ / IMU_RATE_HZ, else VISION_PROFILE
# (full: camera 30 Hz, IMU 200 Hz; cpu: camera 10 Hz, IMU 100 Hz).
# PX4 IMU expected rate is PX4_IMU_RATE_HZ (default 100).
# PREFLIGHT_MIN_CAMERA_HZ=
# PREFLIGHT_MIN_IMU_HZ=
# PREFLIGHT_MIN_GT_HZ=20
# PREFLIGHT_CLOCK_MAX_AGE_S=1.0
# PREFLIGHT_CAMERA_TOPIC=/camera/rgb/image_raw
# PREFLIGHT_IMU_TOPIC=/imu
# PREFLIGHT_GT_TOPIC=/ground_truth/odom
# GT_CHILD_FRAME=base_link_gt
# SIM_RTF_WINDOW_S=5
# PREFLIGHT_TF_PAIRS=world:spawn,world:base_link_gt,base_link:camera_rgb_frame,base_link:imu_link
# Stereo uses base_link:stereo_left_camera_frame instead of camera_rgb_frame when this is unset.

# Spawn geographic coordinate (not the Gazebo world origin).
# Aerospace Engineering Department, Amirkabir University of Technology, Tehran.
# Ground elevation is about 1205 m AMSL (SRTM 30 m 1206, Open-Meteo 1204).
SIM_ORIGIN_LAT=35.7048378
SIM_ORIGIN_LON=51.4095049
SIM_ORIGIN_ALT=1205
