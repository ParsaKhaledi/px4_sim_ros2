# Docker image registry and tag (update px4TAG after CI builds)
registry=docker.io/alienkh
px4TAG=v3.0.0

# GPU image (deferred — see README)
registryGPU=docker.io/alienkh
px4GPUTAG=v3.0.0_GPU

# Runtime defaults (override on command line)
# CameraType=rgbd
# World=default

# Gazebo. HEADLESS=1 runs the server with EGL rendering and no GUI.
# HEADLESS=0
# HEADLESS_BACKEND=egl
# HEADLESS_SOFTWARE=0
# Spawn pose x,y,z,roll,pitch,yaw in the Gazebo ENU world (radians).
# PX4_GZ_MODEL_POSE=-3,-1.6,0,0,0,3.14
# USE_SIM_TIME=true

# /sim/preflight_check thresholds
# PREFLIGHT_MIN_RTF=0.8
# PREFLIGHT_MAX_POSE_ERR_M=0.10
# PREFLIGHT_MIN_CAMERA_HZ=5
# PREFLIGHT_MIN_IMU_HZ=10
# PREFLIGHT_MIN_GT_HZ=20
# PREFLIGHT_CLOCK_MAX_AGE_S=1.0
# PREFLIGHT_CAMERA_TOPIC=/camera/rgb/image_raw
# PREFLIGHT_IMU_TOPIC=/imu/data
# PREFLIGHT_GT_TOPIC=/ground_truth/odom

# Spawn geographic coordinate (not the Gazebo world origin).
# Aerospace Engineering Department, Amirkabir University of Technology, Tehran.
# Ground elevation is about 1205 m AMSL (SRTM 30 m 1206, Open-Meteo 1204).
SIM_ORIGIN_LAT=35.7048378
SIM_ORIGIN_LON=51.4095049
SIM_ORIGIN_ALT=1205
