# Docker image registry and tag (update px4TAG after CI builds)
registry=docker.io/alienkh
px4TAG=v3.0.0

# GPU image (deferred — see README)
registryGPU=docker.io/alienkh
px4GPUTAG=v3.0.0_GPU

# Runtime defaults (override on command line)
# CameraType=rgbd
# World=default

# Gazebo. HEADLESS=1 runs the server with EGL rendering and no GUI.
# HEADLESS=0
# HEADLESS_BACKEND=egl
# HEADLESS_SOFTWARE=0
# Spawn pose x,y,z,roll,pitch,yaw in the Gazebo ENU world (radians).
# z is drop clearance above the floor. The spawn frame stays at z = 0.
# PX4_GZ_MODEL_POSE=-3,-1.6,0.15,0,0,3.14
# USE_SIM_TIME=true
# Single-ray downward lidar on x500_depth. LIDAR_DOWN=0 leaves it off.
# LIDAR_DOWN=1
# LIDAR_DOWN_RATE_HZ=30

# /sim/preflight_check thresholds.
# PREFLIGHT_MIN_RTF is optional. Unset: 0.15 when HEADLESS_SOFTWARE=1, else 0.8.
# PREFLIGHT_MIN_RTF=0.15
# PREFLIGHT_MAX_POSE_ERR_M=0.10
# IMU on ROS /imu. oak bridges the Oak-D camera IMU (frame imu_link).
# That bridge is the only /imu publisher.
# IMU_SOURCE=oak
# OAK-D S2 mount on the x500. Pitch is degrees, positive lens-down.
CAM_PITCH_DEG=17
CAM_X=0.12
CAM_Y=0.03
CAM_Z=0.242
RTABMAPVIZ=false
# VISION_PROFILE is the cpu profile: 320x200 at 10 Hz, IMU 100 Hz.
VISION_PROFILE=cpu
# Camera and IMU minimums are optional. Unset, the camera minimum is half the
# expected rate (CAM_RATE_HZ, else the cpu profile at 10 Hz).
# Expected IMU rate is IMU_RATE_HZ, else the cpu profile imu_hz (100 Hz),
# else the Oak-D model update_rate, else 100 Hz. The minimum is 0.75 of that rate.
# HealthCheck/rtabmap_health_log.py gates, from /rtabmap/odom_info.
VISION_MAX_LOST_STREAK=3
VISION_MAX_RECOVERY_FRAMES=2
# Sim-time odometry rate. cpu (measured at 320x200): VISION_MIN_MEDIAN_FEATURES=40
VISION_MIN_ODOM_HZ=7
# cpu (measured at 320x200): VISION_MIN_INLIERS=15
# PREFLIGHT_MIN_CAMERA_HZ=
# PREFLIGHT_MIN_IMU_HZ=
# PREFLIGHT_MIN_GT_HZ=20
# PREFLIGHT_CLOCK_MAX_AGE_S=1.0
# PREFLIGHT_CAMERA_TOPIC=/camera/rgb/image_raw
# Camera rate uses camera_info, derived from the image topic unless set.
# PREFLIGHT_CAMERA_INFO_TOPIC=/camera/rgb/camera_info
# PREFLIGHT_IMU_TOPIC=/imu
# PREFLIGHT_GT_TOPIC=/ground_truth/odom
# GT_CHILD_FRAME=base_link_gt
# SIM_RTF_WINDOW_S=5
# PREFLIGHT_TF_PAIRS=world:spawn,world:base_link_gt,base_link:camera_rgb_frame,base_link:imu_link
# Stereo uses base_link:stereo_left_camera_frame instead of camera_rgb_frame when this is unset.

# Spawn geographic coordinate (not the Gazebo world origin).
# Aerospace Engineering Department, Amirkabir University of Technology, Tehran.
# Ground elevation is about 1205 m AMSL (SRTM 30 m 1206, Open-Meteo 1204).
SIM_ORIGIN_LAT=35.7048378
SIM_ORIGIN_LON=51.4095049
SIM_ORIGIN_ALT=1205
